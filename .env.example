########################################
# Example .env for local Keycloak stack
# Copy to .env and fill secrets as needed.
# Mirrors docker-compose.yaml environment defaults.
########################################

# --- Keycloak ---
KC_FEATURES=declarative-ui
KC_LOG_LEVEL_IO_GITHUB_MABARTOS=trace
# KC_FEATURES=declarative-ui,ssf   # ssf: nightly/upstream only

# --- Core SPI defaults ---
KC_SPI_RISK_ENGINE__PROVIDER=default-mutiny
JAVA_OPTS_APPEND=--enable-preview

# Risk score algorithm: weighted-average | log-odds
KC_SPI_RISK_SCORE_ALGORITHM__PROVIDER=log-odds

# AI engine: gpt | claude | gemini | granite | openrouter
KC_SPI_AI_ENGINE__PROVIDER=granite

# --- AI anonymization (docs/privacy-and-anonymization.md) ---
AI_ANONYMIZE_ENABLED=true
AI_ANONYMIZE_SALT=
# Production: set a stable salt (openssl rand -base64 32)

# --- OpenAI ChatGPT (provider id: gpt) ---
OPEN_AI_API_URL=https://api.openai.com/v1/chat/completions
OPEN_AI_API_KEY=
OPEN_AI_API_ORGANIZATION=
OPEN_AI_API_PROJECT=
OPEN_AI_API_MODEL=gpt-4o-mini

# --- Anthropic Claude (provider id: claude) ---
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_API_KEY=
CLAUDE_API_MODEL=claude-haiku-4-5-20251001
CLAUDE_API_VERSION=2023-06-01
CLAUDE_API_ENABLE_CACHING=true

# --- Google Gemini (provider id: gemini) ---
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.5-flash-lite

# --- IBM Granite (provider id: granite, deprecated) ---
# URL must include /chat/completions
GRANITE_API_URL=
GRANITE_API_KEY=
GRANITE_API_MODEL=granite-8b-code-instruct-128k

# --- OpenRouter extension (provider id: openrouter) ---
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_API_MODEL=

# --- reCAPTCHA evaluator ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_PROJECT_API_KEY=

# --- extensions/ip-api + core location / IP testing ---
# GeoIP chain: ipapi-co-free | ipapi-co-pro | ip-api-com-free | ip-api-com-pro
KC_ADAPTIVE_LOCATION_PROVIDERS=ipapi-co-free
KC_ADAPTIVE_IPAPI_TOKEN=
KC_ADAPTIVE_IP_API_COM_API_KEY=
KC_ADAPTIVE_LOCATION_GLOBAL_CACHE_TTL=PT24H
KC_ADAPTIVE_LOCATION_GLOBAL_CACHE_MAXIMUM_SIZE=10000
# ⚠️ Dev only: do not enable in production
KC_ADAPTIVE_TESTING_RANDOM_IP_ENABLED=true
KC_ADAPTIVE_TESTING_IP_VALUE=45.157.112.190
